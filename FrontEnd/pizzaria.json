{
  "openapi": "3.0.1",
  "info": {
    "title": "API da Pizzaria",
    "description": "API para gerenciar pizzas, clientes e pedidos de uma pizzaria.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/pizzaria/api",
      "description": "Servidor local de desenvolvimento"
    }
  ],
  "paths": {
    "/pizzas": {
      "get": {
        "summary": "Listar todas as pizzas",
        "responses": {
          "200": {
            "description": "Lista de pizzas retornada com sucesso",
            "content": {
              "application/json": {
                "example": [
                  { "id": 1, "nome": "Margherita", "preco": 35.0, "tamanho": "Média" },
                  { "id": 2, "nome": "Calabresa", "preco": 40.0, "tamanho": "Grande" }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Adicionar uma nova pizza",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "preco": { "type": "number" },
                  "tamanho": { "type": "string" }
                }
              },
              "example": { "nome": "Frango com Catupiry", "preco": 45.0, "tamanho": "Grande" }
            }
          }
        },
        "responses": {
          "201": { "description": "Pizza criada com sucesso" }
        }
      }
    },
    "/pizzas/{id}": {
      "get": {
        "summary": "Obter detalhes de uma pizza",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Detalhes da pizza retornados com sucesso",
            "content": {
              "application/json": {
                "example": { "id": 1, "nome": "Margherita", "preco": 35.0, "tamanho": "Média" }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Atualizar uma pizza existente",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "preco": { "type": "number" },
                  "tamanho": { "type": "string" }
                }
              },
              "example": { "nome": "Calabresa Especial", "preco": 42.0, "tamanho": "Grande" }
            }
          }
        },
        "responses": {
          "200": { "description": "Pizza atualizada com sucesso" }
        }
      },
      "delete": {
        "summary": "Excluir uma pizza",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Pizza excluída com sucesso" }
        }
      }
    },
    "/clientes": {
      "get": {
        "summary": "Listar clientes",
        "responses": {
          "200": {
            "description": "Lista de clientes retornada com sucesso",
            "content": {
              "application/json": {
                "example": [
                  { "id": 1, "nome": "João Silva", "telefone": "81999999999" },
                  { "id": 2, "nome": "Maria Souza", "telefone": "81988888888" }
                ]
              }
            }
          }
        }
      }
    },
    "/pedidos": {
      "post": {
        "summary": "Criar um novo pedido",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clienteId": { "type": "integer" },
                  "pizzas": {
                    "type": "array",
                    "items": { "type": "integer" }
                  },
                  "enderecoEntrega": { "type": "string" }
                }
              },
              "example": {
                "clienteId": 1,
                "pizzas": [1, 2],
                "enderecoEntrega": "Rua das Flores, 123"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Pedido criado com sucesso" }
        }
      }
    }
  }
}
